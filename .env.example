# Copy to .env and fill in. .env is git-ignored.

# Personal token: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=
# The API asks for a unique User-Agent that identifies the application (ideally with a URL)
DISCOGS_USER_AGENT=DiscogsDataLake/2.0 +https://github.com/<your-user>/discogs-data-lake

# S3 storage (SeaweedFS), used by Spark, Hive Metastore and Trino
S3_ACCESS_KEY=lake
S3_SECRET_KEY=change-me
LAKE_BUCKET=lakehouse
S3_ENDPOINT=http://seaweedfs:8333

# Admin user for the Airflow UI
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# Airflow port on the host (default 8080)
# AIRFLOW_PORT=8080
