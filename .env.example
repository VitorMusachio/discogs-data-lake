# Copie para .env e preencha. O .env não vai para o git.

# Token pessoal: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=
# A API pede um User-Agent único que identifique a aplicação (de preferência com URL)
DISCOGS_USER_AGENT=DiscogsDataLake/2.0 +https://github.com/<seu-usuario>/discogs-data-lake

# MinIO (também usado por Spark, Hive Metastore e Trino)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=troque-esta-senha
LAKE_BUCKET=lakehouse
S3_ENDPOINT=http://minio:9000

# Usuário admin da interface do Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=troque-esta-senha
